meta {
  name: Contrasena incorrecta (401)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "correo": "{{correo}}",
    "contrasena": "NoEsMiClave123"
  }
}

tests {
  test("401 con credenciales incorrectas", function () {
    expect(res.getStatus()).to.equal(401);
  });
}
