meta {
  name: Actualizar producto (PUT)
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/productos/{{productoId}}
  body: json
  auth: inherit
}

body:json {
  {
    "codigo": "{{productoCodigo}}",
    "nombre": "Carpeta tamaño oficio",
    "descripcion": "Carpeta de plástico con broche y separadores",
    "precio": 29.50,
    "existencias": 65,
    "categoriaId": 1
  }
}

tests {
  test("200 con los datos nuevos", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().nombre).to.equal("Carpeta tamaño oficio");
  });
}
