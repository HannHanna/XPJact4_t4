meta {
  name: Ver producto
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/productos/{{productoId}}
  body: none
  auth: inherit
}

tests {
  test("200 con el producto creado", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().id).to.equal(Number(bru.getVar("productoId")));
  });
}
