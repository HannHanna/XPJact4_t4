meta {
  name: Ajustar existencias (PATCH)
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/api/productos/{{productoId}}
  body: json
  auth: inherit
}

body:json {
  {
    "existencias": 12
  }
}

tests {
  test("200 y solo cambian las existencias", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().existencias).to.equal(12);
  });
}
